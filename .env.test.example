# Copy to .env.test (git-ignored) to run the tests: cp .env.test.example .env.test
# These point at the throwaway Postgres from docker-compose.test.yml (yarn test:db:up), never at a real database.
# The test runner refuses to start unless both URLs are localhost and the database name contains "test".
DATABASE_URL="postgresql://postgres:test@localhost:5433/apparelflow_test"
DIRECT_URL="postgresql://postgres:test@localhost:5433/apparelflow_test"
# Test-only value (32+ characters). The real secret is set only in Vercel.
JWT_SECRET="test-only-secret-not-for-production-0123456789"
