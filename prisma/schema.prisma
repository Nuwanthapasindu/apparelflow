// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Vercel runs on Linux; without this only the local machine's engine is generated.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
  // One SQL statement for a query with nested relations instead of one per relation (fewer round trips).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum Role {
  cutting_supervisor
  cutting_verifier
  sewing_supervisor
}

enum OrderStatus {
  CUTTING_IN_PROGRESS // reserved for the brief's state machine; order creation inserts PENDING_VERIFICATION directly
  PENDING_VERIFICATION
  REJECTED
  VERIFIED
  IN_SEWING
}

enum ItemStatus {
  GREEN
  YELLOW
  RED
}

enum Decision {
  APPROVED
  REJECTED
}

// ---------- Auth ----------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  fullName     String   @map("full_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  createdOrders CuttingOrder[]    @relation("OrderCreator")
  sewingStarted CuttingOrder[]    @relation("SewingStarter")
  verifications VerificationLog[]
  refreshTokens RefreshToken[]

  @@map("users")
}

// Opaque rotating refresh tokens. Only the SHA-256 hash is stored.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  familyId  String    @map("family_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Recipes (seeded, read-only in the app) ----------

model Recipe {
  id             String  @id @default(uuid())
  recipeCode     String  @unique @map("recipe_code")
  name           String
  category       String
  stdFabricYards Decimal @map("std_fabric_yards") @db.Decimal(8, 2)
  wastageCap     Decimal @map("wastage_cap") @db.Decimal(5, 2)

  components RecipeComponent[]
  orders     CuttingOrder[]

  @@map("recipes")
}

model RecipeComponent {
  id               String  @id @default(uuid())
  recipeId         String  @map("recipe_id")
  componentName    String  @map("component_name")
  piecesPerGarment Int     @map("pieces_per_garment")
  imageUrl         String? @map("image_url")

  recipe Recipe             @relation(fields: [recipeId], references: [id])
  items  VerificationItem[]

  @@unique([recipeId, componentName])
  @@map("recipe_components")
}

// ---------- Orders ----------

model CuttingOrder {
  id              String      @id @default(uuid())
  orderNo         String      @unique @map("order_no")
  recipeId        String      @map("recipe_id")
  targetQty       Int         @map("target_qty")
  fabricRollId    String      @map("fabric_roll_id")
  actualFabricYds Decimal     @map("actual_fabric_yds") @db.Decimal(8, 2)
  status          OrderStatus @default(PENDING_VERIFICATION)
  currentAttempt  Int         @default(1) @map("current_attempt")
  createdById     String      @map("created_by")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Set only by POST /api/sewing/:id/start, from the session
  sewingStartedById String?   @map("sewing_started_by")
  sewingStartedAt   DateTime? @map("sewing_started_at")

  recipe        Recipe             @relation(fields: [recipeId], references: [id])
  createdBy     User               @relation("OrderCreator", fields: [createdById], references: [id])
  sewingStarter User?              @relation("SewingStarter", fields: [sewingStartedById], references: [id])
  items         VerificationItem[]
  logs          VerificationLog[]

  @@index([status])
  @@index([createdById])
  @@map("cutting_orders")
}

// ---------- Verification ----------

// One row per (order, component, attempt). Rows are created at submit/resubmit with
// actualQty = NULL ("uncounted"), so the API can detect uncounted components and return 422.
// expectedQty and componentName are SNAPSHOTS: later recipe edits never change history.
model VerificationItem {
  id            String      @id @default(uuid())
  orderId       String      @map("order_id")
  componentId   String      @map("component_id")
  attemptNo     Int         @default(1) @map("attempt_no")
  componentName String      @map("component_name")
  expectedQty   Int         @map("expected_qty")
  actualQty     Int?        @map("actual_qty")
  status        ItemStatus? // computed server-side only; NULL until counted

  order     CuttingOrder    @relation(fields: [orderId], references: [id])
  component RecipeComponent @relation(fields: [componentId], references: [id])

  @@unique([orderId, componentId, attemptNo])
  @@index([orderId, attemptNo])
  @@map("verification_items")
}

// Append-only. Exactly one decision per (order, attempt), which is also the
// race-condition guard: two verifiers cannot both decide the same attempt.
model VerificationLog {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  attemptNo     Int      @map("attempt_no")
  verifierId    String   @map("verifier_id")
  decision      Decision
  rejectionNote String?  @map("rejection_note")

  // Fabric snapshot, frozen at APPROVAL (NULL on rejection)
  expectedFabricYds Decimal? @map("expected_fabric_yds") @db.Decimal(10, 2)
  actualFabricYds   Decimal? @map("actual_fabric_yds") @db.Decimal(8, 2)
  wastagePct        Decimal? @map("wastage_pct") @db.Decimal(14, 2)
  wastageCapPct     Decimal? @map("wastage_cap_pct") @db.Decimal(5, 2)
  overCap           Boolean? @map("over_cap")

  decidedAt DateTime @default(now()) @map("timestamp") // server clock, never client-supplied

  order    CuttingOrder @relation(fields: [orderId], references: [id])
  verifier User         @relation(fields: [verifierId], references: [id])

  @@unique([orderId, attemptNo])
  @@index([verifierId])
  @@map("verification_logs")
}
