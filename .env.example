# Copy to .env (git-ignored) and fill in real values. This file lists names only: never commit real values.

# Runtime connection: the Supabase TRANSACTION pooler (port 6543), with pgbouncer=true so Prisma does not rely on
# session features. Prisma's pool defaults to (CPUs * 2 + 1) connections per instance; only add connection_limit=<n>
# to the URL if the pooler reports too many clients. pool_timeout defaults to 10 seconds.
DATABASE_URL=

# Migrations: the Supabase SESSION pooler (port 5432) or the direct connection. Run by hand, never during the host build:
#   yarn prisma migrate deploy
DIRECT_URL=

# At least 32 random characters, different from the test value, set only in the host's environment variables and your local .env.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
