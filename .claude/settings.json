{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(yarn lint)",
      "Bash(yarn build)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx prisma generate)",
      "Read(./.env.example)",
      "Edit(./.env.example)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.test)",
      "Bash(yarn prisma migrate reset:*)",
      "Bash(yarn prisma db push:*)",
      "Bash(git push --force:*)"
    ]
  }
}
